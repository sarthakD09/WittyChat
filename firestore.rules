rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Only authenticated users can read/write their own user doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Only the owner can read/write their userChats
    match /userChats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Messages can be added/read if user is part of chat (basic version)
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if request.auth != null;
      // Optional: Add logic to check membership
    }
  }
}
